{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "6a0e3b8a4a3e4d5092477704e8f8623f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "BlendThreeColors (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 288.0,
            "y": 543.3333740234375,
            "width": 257.33331298828127,
            "height": 375.99993896484377
        }
    },
    "m_Slots": [
        {
            "m_Id": "a91f87711b924f3d9066a4df8e181e1e"
        },
        {
            "m_Id": "2f1711ebc4b9410699eff55a5638c7ca"
        },
        {
            "m_Id": "94af42ab137944c3aea6826620a787de"
        },
        {
            "m_Id": "7381441bd77f47c2b78aeb30ccd5ac7b"
        },
        {
            "m_Id": "34855bdb8119471d91da4433dded7cc4"
        },
        {
            "m_Id": "7a4edf8590124b4385ed37ad2d0ce050"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BlendThreeColors",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\r\r\n    float3 light_color = float3(1.0, 1.0, 1.0);\n\r\n\r\n    float rWeight = 1.0 - smoothstep(shadow_value, edge_value, abs(value - shadow_value));\r\n    float bWeight = min(smoothstep(shadow_value, edge_value, value), (1.0- smoothstep(edge_value, 0.6, value)));\r\n    float yWeight = smoothstep(edge_value, 0.6, value);\r\n\r\n    float total = rWeight + bWeight + yWeight;\r\n    rWeight /= total;\r\n    bWeight /= total;\r\n    yWeight /= total;\r\n\r\ncolor = shadow_color * rWeight + edge_color * bWeight + light_color * yWeight;\r"
}

